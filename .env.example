# 复制成 .env 后按需改
ENV=dev
APP_NAME=BidSentry

# psycopg3 驱动，必须是 postgresql+psycopg://
DATABASE_URL=postgresql+psycopg://bidsentry:bidsentry@localhost:5433/bidsentry

# 开发期随便填，上线必须换
SECRET_KEY=dev-only-change-me
ACCESS_TOKEN_EXPIRE_MINUTES=1440

UPLOAD_DIR=data/uploads
MAX_UPLOAD_MB=50

# 第 4 天才用得上，先留空
DEEPSEEK_API_KEY=
